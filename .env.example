HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_MEETINGS=meetings-bank
HINDSIGHT_BANK_MEMBERS=members-bank
HINDSIGHT_BANK_TASKS=tasks-bank
GROQ_API_KEY=your_groq_api_key_here
# Production IDs: llama-3.1-8b-instant (fast) | llama-3.3-70b-versatile (stronger)
GROQ_MODEL=llama-3.1-8b-instant
DATABASE_URL=postgresql+asyncpg://nexus:nexuspass@localhost:5432/nexuspm
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
NEXUS_AGENT_NAME=NEXUS
NEXUS_AGENT_PERSONA=direct,analytical,occasionally_dry_humor

# Slack digest delivery (optional)
# Get webhook: api.slack.com/apps -> Incoming Webhooks -> Add to Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_DIGEST_CHANNEL=#nexus-daily

# Email digest delivery (optional)
# Works with Gmail (use App Password), SendGrid, or any SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password_here
DIGEST_EMAIL_FROM=nexus@yourproject.com
DIGEST_EMAIL_TO=team@yourproject.com,alice@example.com,bob@example.com

# Digest schedule (24-hour format, server local time)
DIGEST_HOUR=8
DIGEST_MINUTE=0
